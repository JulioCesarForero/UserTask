@model List<ASPRad.Models.Users>
    @{
    Layout = "_ReportLayout";
    var record = Model.First();
    }
    <div id="report-title"><h1>User Details</h1></div>
    <table class="table table-sm table-striped">
        <tbody>
            <tr>
                <th>User Id</th>
                <td>@record.user_id</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>@record.title</td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>@record.first_name</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>@record.last_name</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@record.email</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>@record.phone</td>
            </tr>
            <tr>
                <th>Username</th>
                <td>@record.username</td>
            </tr>
            <tr>
                <th>User Role Id</th>
                <td>@record.user_role_id</td>
            </tr>
        </tbody>
    </table>