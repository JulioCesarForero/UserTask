@model List<ASPRad.Models.TaskPriorities>
    @{
    Layout = "_ReportLayout";
    var record = Model.First();
    }
    <div id="report-title"><h1>Task Priority Details</h1></div>
    <table class="table table-sm table-striped">
        <tbody>
            <tr>
                <th>Priority Id</th>
                <td>@record.priority_id</td>
            </tr>
            <tr>
                <th>Priority Name</th>
                <td>@record.priority_name</td>
            </tr>
        </tbody>
    </table>